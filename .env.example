# Copy to .env and fill in. Every value here has a working default except the
# key for whichever LLM provider you choose.

# ─── LLM ──────────────────────────────────────────────────────────────────────
# ollama    local, GPU, no rate limits — run `ollama pull qwen2.5:7b-instruct`
# groq      hosted free tier, very fast — https://console.groq.com/keys
# anthropic Claude, best reasoning — https://console.anthropic.com/settings/keys
# echo      offline stub, no model at all (canned questions)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Rate limits are per model: on a 429, fail over to these instead of waiting.
GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# ─── Speech and scoring ───────────────────────────────────────────────────────
WHISPER_MODEL=base.en
SPEECH_ENABLED=true
EMBEDDINGS_ENABLED=true

# ─── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL, if set, overrides the POSTGRES_* values.
POSTGRES_USER=voicehr
POSTGRES_PASSWORD=voicehr_dev_password
POSTGRES_DB=voicehr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-production

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Frontend, build time. Leave empty when the API is served from the same origin.
VITE_API_BASE_URL=
